# Cloudflare Zone DNS API Token for zakariafadli.com (restricted to home IP)
CLOUDFLARE_ZONE_DNS_ZAKARIAFADLICOM_FROM_HOME_IP_ONLY="cfut_your_cloudflare_zone_dns_token"

# Cloudflare Workers Edit API Token (restricted to home IP)
CLOUDFLARE_WORKERS_API_TOKEN_FROM_HOME_IP_ONLY="cfut_your_cloudflare_workers_token"

# Cloudflare Create Additional Tokens (restricted to home IP)
# NOTE: Expires after 2026. MUST be used by Opus-level or higher autonomous agents ONLY
# to create tokens with limited scope for specific GitHub CIs (since GitHub Actions runners
# cannot use the home-IP-restricted tokens above).
CLOUDFLARE_CREATE_ADDITIONAL_TOKENS_2026_FROM_HOME_IP_ONLY="cfut_your_cloudflare_create_tokens_token"

# Cloudflare Pages: Edit for the account, no IP limit, for salsa-social GitHub Actions deploy.
# Minted from the create-tokens key; also stored as the CLOUDFLARE_API_TOKEN repo secret.
CLOUDFLARE_PAGES_DEPLOY_SALSA_SOCIAL_CI="cfut_your_cloudflare_pages_deploy_token"
