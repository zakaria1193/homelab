# Homelab Weekly Security Checker Service - Environment Template

# Enable automatic Slack notifications on audit execution (default: 1)
SECURITY_CHECKER_SLACK_NOTIFY=1

# Optional override target Slack channel (default: #general)
SECURITY_CHECKER_SLACK_CHANNEL=#general

# --- AI Security Audit Configuration -------------------------------------
# AI CLI binary used for automated security evaluation (default: agy)
# Easily replaceable with 'claude' or any configured AI CLI tool.
SECURITY_CHECKER_AI_CLI=agy

# Enable AI-assisted security evaluation of registered services (default: 1)
SECURITY_CHECKER_ENABLE_AI=1

# --- Agent Skill Scan (NVIDIA SkillSpector) ------------------------------
# Enable the weekly agent-skill scan, step 5 of the audit (default: 1)
SECURITY_CHECKER_ENABLE_SKILLSCAN=1

# Colon-separated list of folders to scan for installed agent skills.
# '~' and glob patterns are expanded; each real path is scanned once even
# if reached through more than one of these entries (e.g. a symlink).
# Missing folders are skipped without a warning.
#   ~/.claude/skills                  - Claude Code's own installed skills
#   ~/.claude/plugins                 - installed Claude Code plugins and
#                                        the skills inside them
#   ~/my_repos/*/.claude/skills       - project-local skills in every repo
#   ~/.gemini/config/skills           - Antigravity (agy)'s installed skills
#   ~/.gemini/antigravity-cli/plugins - installed agy plugins and the
#                                        skills inside them
SECURITY_CHECKER_SKILL_PATHS=~/.claude/skills:~/.claude/plugins:~/my_repos/*/.claude/skills:~/.gemini/config/skills:~/.gemini/antigravity-cli/plugins

# Per-skill SkillSpector scan timeout in seconds (default: 120)
SECURITY_CHECKER_SKILLSCAN_TIMEOUT=120

# Part B of the skill scan: each skill's main file (SKILL.md, or the agent
# file) is sent to SECURITY_CHECKER_AI_CLI for an LLM review (prompt
# injection / hidden instructions / data theft / unsafe commands). Verdicts
# are cached by real path + file SHA-256 + CLI name in the git-ignored
# skillscan_cache.json, so an unchanged file is not re-sent to the CLI.
# Uses SECURITY_CHECKER_ENABLE_AI above to turn Part B on/off (Part A, the
# static SkillSpector scan, always runs). Per-skill CLI timeout in seconds:
SECURITY_CHECKER_AI_SKILLSCAN_TIMEOUT=60
