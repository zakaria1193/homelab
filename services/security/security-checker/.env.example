# Homelab Weekly Security Checker Service - Environment Template

# Enable automatic Slack notifications on audit execution (default: 1)
SECURITY_CHECKER_SLACK_NOTIFY=1

# Optional override target Slack channel (default: #general)
SECURITY_CHECKER_SLACK_CHANNEL=#general

# --- AI Security Audit Configuration -------------------------------------
# AI CLI binary used for automated security evaluation (default: agy)
# Easily replaceable with 'claude' or any configured AI CLI tool.
SECURITY_CHECKER_AI_CLI=agy

# Enable AI-assisted security evaluation of registered services (default: 1)
SECURITY_CHECKER_ENABLE_AI=1
