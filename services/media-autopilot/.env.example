# ------------------------------------------------------------------ Jellyfin
# An API key: Jellyfin > Dashboard > API Keys > "+" (name it media-autopilot).
# The job uses it to read every user's watch state.
JELLYFIN_API_KEY=
# JELLYFIN_URL=http://127.0.0.1:8096

# ------------------------------------------------------------------- Sonarr
# Left empty, the key is read from services/media/sonarr/config.xml.
SONARR_API_KEY=
# SONARR_URL=http://127.0.0.1:8989

# ------------------------------------------------------------------- Radarr
# Left empty, the key is read from services/media/radarr/config.xml.
RADARR_API_KEY=
# RADARR_URL=http://127.0.0.1:7878

# ------------------------------------------------------------------ policy
# How many episodes after the furthest one watched stay monitored.
KEEP_AHEAD=2
# Watched episodes are deleted (and unmonitored) after this many days.
DELETE_AFTER_DAYS=3
# A show with no viewing for this many days is left to you (no grabs, no deletes).
STALE_DAYS=30
# A show on disk with no viewing for this many days gets one Slack warning.
ABANDONED_DAYS=365
# A movie finished within this many days is announced on Slack and deleted MOVIE_WARN_DAYS
# later, unless it is on the maintained list (cockpit > Media). Older plays are left alone.
MOVIE_WINDOW_DAYS=30
MOVIE_WARN_DAYS=7
# Hopping shows are never touched, but if together they exceed this share of the
# disk the autopilot posts a Slack warning on EVERY run until you trim them.
HOPPING_MAX_DISK_FRACTION=0.5
# Safety net: at most this many files deleted per run.
MAX_DELETES_PER_RUN=25
# Shows watched out of order are never touched: see hopping.json, edited from
# the cockpit's Media tab (or `python3 autopilot.py hopping add "<Sonarr title>"`).
# Slack channel for the "searching / deleted" summaries.
# AUTOPILOT_SLACK_CHANNEL=media-server
