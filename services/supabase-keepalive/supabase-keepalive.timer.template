[Unit]
Description=Twice-weekly keepalive ping for free-tier Supabase projects
Documentation=file://{{CURR_DIR}}/README.md

[Timer]
# Sunday and Wednesday mornings: the longest gap is four days, well inside
# the seven-day idle window, and one missed run still leaves a ping in time.
OnCalendar=Sun,Wed *-*-* 03:30:00
# The homelab is not always up at 03:30. Persistent=true makes systemd run the
# missed job as soon as it is, which is what keeps the promise across a
# reboot or a holiday.
Persistent=true
RandomizedDelaySec=30m
AccuracySec=1h
Unit=supabase-keepalive.service

[Install]
WantedBy=timers.target
