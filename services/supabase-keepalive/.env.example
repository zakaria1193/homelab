# ---------------------------------------------------------------- discovery
# A Supabase personal access token (https://supabase.com/dashboard/account/tokens).
# With it the job lists every project on the account and reads each one's anon
# key itself, so a new project is covered without touching this file.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Projects the token above cannot see (another account, another organisation).
# One per line: name|https://<ref>.supabase.co|<anon key>[|table]
# SUPABASE_PROJECTS="farah|https://abcdefgh.supabase.co|eyJhbGciOi...|schools"

# ------------------------------------------------------------------- pinging
# A table to select one row from, which makes the ping an unmistakable database
# query. Leave it empty to hit the PostgREST root instead. The table only has
# to exist — row-level security may refuse the read, the query still happened.
SUPABASE_KEEPALIVE_TABLE=

# When to post to Slack: never | error | always
SUPABASE_KEEPALIVE_NOTIFY=error
