# Karakeep — bookmark manager (docker compose).
#
# The real values live in `.env` next to this file, committed as git-crypt
# ciphertext. This template is what a fresh machine starts from, so every
# secret here is a placeholder.

KARAKEEP_VERSION=release
NEXTAUTH_URL=http://localhost:3000

# Signing key for sessions. Any 32+ random bytes: `openssl rand -base64 36`
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meilisearch master key, shared with the karakeep-meilisearch container.
MEILI_MASTER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI tagging and summarising: uses homelab's aicli-ai service by default.
# To disable AI features, comment out or leave OPENAI_API_KEY empty.
OPENAI_API_KEY=aicli
OPENAI_BASE_URL=http://host.docker.internal:8500/v1
INFERENCE_TEXT_MODEL=claude
SEMANTIC_SEARCH_ENABLED=false
