# GitHub Personal Access Token (fine-grained)
# Used by AI agent runs (pjm, cockpit tmux shells, Claude/agy sessions)
# Can be generated at: https://github.com/settings/tokens
GH_TOKEN=github_pat_your_token_here

# GitHub Classic PAT with repo, workflow, read:org, read:packages, delete:packages, user
# Used by Cockpit /github-limits for official billing usage & packages endpoints
GH_TOKEN_ADMIN=ghp_your_classic_token_here
