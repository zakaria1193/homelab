# Reference unit. `make slack-bot-start` renders the {{...}} placeholders for
# the machine it runs on, then installs it system-wide (passwordless sudo) or
# into ~/.config/systemd/user as a fallback.
[Unit]
Description=Homelab Slack ideas bot (Socket Mode -> Obsidian ideas board)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{DIR}}
Environment="PATH={{PATH}}"
Environment="HOME={{HOME}}"
# SLACK_BOT_TOKEN / SLACK_APP_TOKEN. Optional: SLACK_IDEAS_FILE,
# SLACK_IDEAS_CATEGORY, SLACK_IDEAS_ALLOWED_USERS, IDEAS_URL.
EnvironmentFile={{HOME}}/.config/homelab/slack.env
# slack-bolt is the only non-stdlib dependency; uv provides it without a venv to manage.
ExecStart={{UV_BIN}} run --no-project --with slack-bolt python3 {{DIR}}/slack_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target multi-user.target
