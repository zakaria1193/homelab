[Unit]
Description=Homelab Cockpit
# tmux-server.service owns the shells: ordered after it so the socket exists
# before the first terminal is opened, Wants= so the cockpit still starts if
# tmux is missing.
After=network.target network-online.target tmux-server.service
Wants=network-online.target tmux-server.service

[Service]
Type=simple
{{USER_LINE}}
WorkingDirectory={{CURR_DIR}}
Environment="PATH={{PATH_VAL}}"
# Needed so `systemctl --user` and `journalctl --user` probes can reach the
# user session bus (openhands-ai runs in user scope).
Environment="XDG_RUNTIME_DIR={{RUNTIME_DIR}}"
Environment="STATUS_HOST={{STATUS_HOST}}"
Environment="STATUS_PORT={{STATUS_PORT}}"
EnvironmentFile=-{{CURR_DIR}}/.env
ExecStart={{PYTHON_BIN}} {{CURR_DIR}}/status_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target multi-user.target
