# Homelab Cockpit - environment template.
# Copy to .env (git-ignored) with `make env-setup`, then edit as needed.

# Bind address. Keep 0.0.0.0 so cloudflared / LAN clients can reach it.
STATUS_HOST=0.0.0.0
STATUS_PORT=8300

# Page title.
STATUS_TITLE=Homelab Cockpit

# Host used to build the "open service" links on each card. Set this to the
# address your browser uses to reach the homelab (LAN IP or tunnel hostname).
STATUS_LINK_HOST=192.168.1.10

# Seconds between browser refreshes, and how long a probe result is cached
# server-side (so many viewers do not multiply the probe load).
STATUS_REFRESH=15
STATUS_CACHE_TTL=10

# Per-probe timeout in seconds.
STATUS_TIMEOUT=4

# Optional HTTP basic auth. Leave both empty to disable (LAN-only use).
# Set both when exposing the dashboard through a Cloudflare Tunnel.
STATUS_USER=
STATUS_PASSWORD=

# --- Cloudflare Access (Zero Trust) Security ------------------------------
# The cockpit supports Cloudflare Access headers (Cf-Access-Jwt-Assertion and
# Cf-Access-Authenticated-User-Email). Set to 1 to enable (default: 1).
STATUS_CF_ACCESS_ENABLED=1

# Optional: Cloudflare Access Application Audience (AUD) Tag to validate JWT.
STATUS_CF_ACCESS_AUD=

# Optional: Cloudflare Access Team Domain (e.g. myteam.cloudflareaccess.com).
STATUS_CF_ACCESS_TEAM_DOMAIN=

# Optional: Comma-separated list of allowed user emails (e.g. user@example.com).
STATUS_CF_ACCESS_ALLOWED_EMAILS=

# Optional: Set to 1 to strictly require Cloudflare Access authentication and
# reject public requests missing valid Cloudflare Access credentials.
STATUS_REQUIRE_CF_ACCESS=0

# How long "keep me signed in" on the login form lasts, in days. The cookie is
# signed with a key derived from STATUS_PASSWORD, so changing the password
# signs every remembered device out.
STATUS_SESSION_DAYS=30

# Set to 1 to log every HTTP request into journald.
STATUS_ACCESS_LOG=

# --- Browser shells --------------------------------------------------------
# Each card gets a "shell" link: a real PTY opened in that service's directory,
# or `docker exec` inside its container. This is remote code execution as the
# user running this daemon - it is only as strong as STATUS_USER/STATUS_PASSWORD
# above (or a Cloudflare Access policy). Set to 0 to turn the feature off.
STATUS_TERMINAL=1

# Seconds of inactivity before a shell session is closed server-side.
STATUS_TERMINAL_IDLE=900

# Shell to launch for non-container services. Defaults to the account's shell.
STATUS_TERMINAL_SHELL=

# Prefix for persistent named tmux sessions started by the cockpit.
STATUS_TMUX_PREFIX=cockpit-

# Status bar inside cockpit sessions: off keeps the browser terminal clean.
# Set per session, so your own tmux and SSH sessions keep their own bar.
STATUS_TMUX_STATUS_BAR=off

# --- Claude Remote Control instances ---------------------------------------
# /claude-rc lists every `claude remote-control` instance, starts, stops and
# restarts them, and creates new ones (which writes .env.<name> in the RC
# directory, starts the unit and registers it in services.conf). Set to 0 to
# make that page read-only - it still lists and links, but changes nothing.
STATUS_RC_MANAGE=1

# Where the instances live. Defaults to services/AI/claudeRcAI in this repo.
STATUS_RC_DIR=

# Seconds to let `make start`/`stop` run before giving up on it.
STATUS_RC_TIMEOUT=180

# --- Plan-usage health bars -------------------------------------------------
# The header shows 5-hour and weekly limit bars for both `claude` and `agy`,
# read by running each CLI's `/usage` in print mode. Set to 0 if neither CLI
# is installed on this box, or to hide the bars.
STATUS_USAGE=1

# Per-CLI timeout for the `-p "/usage"` call, in seconds.
STATUS_USAGE_TIMEOUT=30

# Seconds a usage snapshot is trusted before the next request triggers a
# background refresh. Usage does not move fast, and each refresh starts a
# whole CLI process, so this is minutes, not seconds.
STATUS_USAGE_REFRESH=300

# --- Project Ideas / Obsidian Vault ----------------------------------------
# Path to your Obsidian project ideas directory. If empty, automatically
# discovers your open vault from ~/.config/obsidian/obsidian.json or checks
# ~/Documents/notes_perso/Project ideas or ~/Documents/Project ideas.
STATUS_PROJECT_IDEAS_DIR=
