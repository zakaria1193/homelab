# Homelab Cockpit - environment template.
# Copy to .env (git-ignored) with `make env-setup`, then edit as needed.

# Bind address. Keep 0.0.0.0 so cloudflared / LAN clients can reach it.
STATUS_HOST=0.0.0.0
STATUS_PORT=8300

# Page title.
STATUS_TITLE=Homelab Cockpit

# Host used to build the "open service" links on each card. Set this to the
# address your browser uses to reach the homelab (LAN IP or tunnel hostname).
STATUS_LINK_HOST=192.168.1.10

# Seconds between browser refreshes, and how long a probe result is cached
# server-side (so many viewers do not multiply the probe load).
STATUS_REFRESH=15
STATUS_CACHE_TTL=10

# Per-probe timeout in seconds.
STATUS_TIMEOUT=4

# Optional HTTP basic auth. Leave both empty to disable (LAN-only use).
# Set both when exposing the dashboard through a Cloudflare Tunnel.
STATUS_USER=
STATUS_PASSWORD=

# Set to 1 to log every HTTP request into journald.
STATUS_ACCESS_LOG=

# --- Browser shells --------------------------------------------------------
# Each card gets a "shell" link: a real PTY opened in that service's directory,
# or `docker exec` inside its container. This is remote code execution as the
# user running this daemon - it is only as strong as STATUS_USER/STATUS_PASSWORD
# above (or a Cloudflare Access policy). Set to 0 to turn the feature off.
STATUS_TERMINAL=1

# Seconds of inactivity before a shell session is closed server-side.
STATUS_TERMINAL_IDLE=900

# Shell to launch for non-container services. Defaults to the account's shell.
STATUS_TERMINAL_SHELL=

# --- Claude Remote Control instances ---------------------------------------
# /claude-rc lists every `claude remote-control` instance, starts, stops and
# restarts them, and creates new ones (which writes .env.<name> in the RC
# directory, starts the unit and registers it in services.conf). Set to 0 to
# make that page read-only - it still lists and links, but changes nothing.
STATUS_RC_MANAGE=1

# Where the instances live. Defaults to services/AI/claudeRcAI in this repo.
STATUS_RC_DIR=

# Seconds to let `make start`/`stop` run before giving up on it.
STATUS_RC_TIMEOUT=180
