[Unit]
Description=One Slack health-check sweep for the homelab cockpit
Documentation=file://{{CURR_DIR}}/README.md
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{CURR_DIR}}
Environment="PATH={{PATH_VAL}}"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-{{CURR_DIR}}/.env
ExecStart={{PYTHON_BIN}} {{CURR_DIR}}/status_server.py --notify

[Install]
WantedBy=default.target multi-user.target
