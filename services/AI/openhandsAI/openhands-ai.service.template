[Unit]
Description=OpenHands AI Agent Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zfadli
WorkingDirectory=/home/zfadli/my_repos/homelab/services/AI/openhandsAI
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/zfadli/.local/bin:/home/zfadli/my_repos/homelab/services/AI/openhandsAI/venv/bin"
Environment="OPENHANDS_HOST=0.0.0.0"
Environment="OPENHANDS_PORT=3030"
EnvironmentFile=-/home/zfadli/my_repos/homelab/services/AI/openhandsAI/.env
ExecStart=npx -y @openhands/agent-canvas -p 3030
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

