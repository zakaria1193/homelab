[Unit]
Description=OpenHands AI Agent Canvas Web UI & Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
{{USER_LINE}}
WorkingDirectory={{CURR_DIR}}
Environment="PATH={{PATH_VAL}}:{{CURR_DIR}}/venv/bin"
Environment="OPENHANDS_HOST={{OPENHANDS_HOST}}"
Environment="OPENHANDS_PORT={{OPENHANDS_PORT}}"
EnvironmentFile=-{{CURR_DIR}}/.env
ExecStart=npx -y @openhands/agent-canvas -p {{OPENHANDS_PORT}}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target multi-user.target
