# Home Assistant SSHFS AI Workspace Configuration
# Used by hass-sshfs-bots to mount Home Assistant configs from Raspberry Pi (192.168.1.11)
# to 192.168.1.10 for bot editing (Claude and Antigravity sessions).

HASS_SSH_HOST=192.168.1.11
HASS_SSH_PORT=22
HASS_SSH_USER=zfadli
HASS_REMOTE_DIR=/config
HASS_MOUNT_DIR=/home/zfadli/my_repos/homelab/services/AI/hass-sshfs-bots/config
SSHFS_OPTIONS=reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,follow_symlinks,auto_unmount
