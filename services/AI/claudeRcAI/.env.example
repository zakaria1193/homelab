# ------------------------------------------------------------------------------
# Claude Remote Control (`claude rc`) Service Configuration
#
# No secrets belong in this file: Remote Control reuses the Claude Code login
# already stored in ~/.claude. Keep values simple KEY=value pairs - this file is
# both sourced by systemd and included by the Makefile.
# ------------------------------------------------------------------------------

# Repository the Remote Control server runs in. Must be a git repo for worktree
# spawn mode, and must already be a trusted workspace (open it once with
# `claude` in a terminal and accept the trust prompt).
RC_WORKDIR=/home/zfadli/my_repos/homelab

# Spawn mode for sessions created from the phone / web:
#   worktree  - each on-demand session gets its own isolated git worktree
#   same-dir  - every session shares RC_WORKDIR
#   session   - one session per connection
RC_SPAWN_MODE=worktree

# Max concurrent sessions hosted by this server.
RC_CAPACITY=32

# Permission mode for spawned sessions:
#   default, acceptEdits, auto, plan, dontAsk, bypassPermissions
RC_PERMISSION_MODE=auto

# Prefix for auto-generated session names shown in claude.ai/code.
RC_SESSION_PREFIX=homelab

# Name of the always-on session that stays in RC_WORKDIR itself.
RC_SESSION_NAME=homelab

# Optional debug log path. The server's stdout is a repainting TUI, so systemd
# discards it; set this to capture real diagnostics to a file.
# RC_DEBUG_FILE=/home/zfadli/my_repos/homelab/services/AI/claudeRcAI/rc-debug.log
