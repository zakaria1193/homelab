[Unit]
Description=Claude Code Remote Control server for {{RC_WORKDIR}}
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
{{USER_LINE}}
WorkingDirectory={{RC_WORKDIR}}
Environment="HOME={{HOME_DIR}}"
Environment="SHELL={{SHELL_BIN}}"
Environment="PATH={{PATH_VAL}}"
Environment="CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX={{RC_SESSION_PREFIX}}"
EnvironmentFile=-{{CURR_DIR}}/{{ENV_FILE}}
ExecStart={{CLAUDE_BIN}} {{RC_ARGS}}
StandardOutput=null
StandardError=journal
Restart=always
RestartSec=15

[Install]
WantedBy=default.target multi-user.target
