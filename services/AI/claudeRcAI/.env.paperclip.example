# ------------------------------------------------------------------------------
# Claude Remote Control - `paperclip` instance
#
# Started with `make start INSTANCE=paperclip`, which installs the unit
# `claude-rc-ai-paperclip` alongside the default `claude-rc-ai`. One Remote
# Control process serves exactly one directory, which is the only reason this
# second instance exists.
#
# Same rules as .env.example: RC_* keys only, no secrets - Remote Control
# authenticates with the credentials already in ~/.claude.
# ------------------------------------------------------------------------------

# The Paperclip MCP client workspace - the directory `agy_paperclip` and
# `claude_paperclip` cd into. Given as its real path rather than the
# ~/paperclip_workspace symlink, so systemd and Claude agree on one identity.
RC_WORKDIR=/home/zfadli/my_repos/homelab/services/AI/paperclipAI

# same-dir, NOT worktree: this workspace is a directory inside the homelab repo,
# not a repo of its own, so worktree mode would branch the wrong tree. Sessions
# here are for driving Paperclip through its MCP config, which only exists in
# the real directory - an isolated copy would be useless.
RC_SPAWN_MODE=same-dir

# Lower than the homelab instance: sessions all share the one directory, so a
# large number of them would just contend.
RC_CAPACITY=8

RC_PERMISSION_MODE=auto
RC_SESSION_PREFIX=paperclip
RC_SESSION_NAME=paperclip

# Optional debug log path. The server's stdout is a repainting TUI, so systemd
# discards it; set this to capture real diagnostics to a file.
# RC_DEBUG_FILE=/home/zfadli/my_repos/homelab/services/AI/claudeRcAI/rc-paperclip-debug.log
