# ------------------------------------------------------------------------------
# Claude Remote Control - `kandev` instance
#
# Started with `make start INSTANCE=kandev` (unit `claude-rc-ai-kandev`).
# Sessions here can drive Kandev through its MCP server (http://127.0.0.1:3040/mcp,
# registered for the `claude` CLI by services/AI/kandevAI `make mcp`).
#
# Same rules as .env.example: RC_* keys only, no secrets.
# ------------------------------------------------------------------------------

# ~/my_repos/kandev is a folder of repos (kandev, kandev-agents, ...), not a
# repo itself, so worktree mode is not possible: use same-dir.
RC_WORKDIR=/home/zfadli/my_repos/kandev

RC_SPAWN_MODE=same-dir
RC_CAPACITY=8
RC_PERMISSION_MODE=auto
RC_SESSION_PREFIX=kandev
RC_SESSION_NAME=kandev
