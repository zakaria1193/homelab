# Antigravity Remote Control daemon - local settings.
#
# No secrets live here: the daemon authenticates with the Google account token
# that `make install` writes during its one-time interactive sign-in, the same
# way claude-rc reuses the credentials already in ~/.claude.

# Instance name shown in the Antigravity Remote Control dashboard's machine
# list. Lowercase letters, numbers and hyphens work best.
AGY_RC_NAME=homelab

# How often the daemon restarts to pick up a new agy build. systemd OnCalendar
# value (daily, weekly, ...). Set AGY_AUTO_UPDATE=0 to drop the timer entirely.
AGY_UPDATE_INTERVAL=daily
AGY_AUTO_UPDATE=1
