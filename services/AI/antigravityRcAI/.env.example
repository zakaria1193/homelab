# Antigravity Remote Control daemon - local settings.
#
# No secrets live here: the daemon authenticates with the credentials in
# ~/.gemini/antigravity-cli, the same way claude-rc reuses ~/.claude.

# The directory this daemon hosts sessions in.
AGY_RC_WORKDIR=/home/zfadli/my_repos/homelab

# Instance name shown in the Antigravity Remote Control dashboard's machine list.
AGY_RC_NAME=homelab

# Hub port (default 4400 for primary daemon)
AGY_RC_PORT=4400
