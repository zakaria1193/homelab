{
  "name": "Slack",
  "type": "slack",
  "enabled": true,
  "events": [
    "task.step_entered",
    "task.completed",
    "session.clarification_requested"
  ],
  "config": {
    "bot_token_env": "SLACK_BOT_TOKEN",
    "default_channel": "#kandev",
    "channels": {
      "Ideas": "#kandev-ideas",
      "kandev": "#kandev",
      "Default Workspace": "#kandev"
    },
    "step_names": [
      "Spec feedback",
      "Human check",
      "Review",
      "Spec",
      "In Progress",
      "Ongoing",
      "Rejected"
    ],
    "base_url": "http://192.168.1.10:3040"
  }
}
