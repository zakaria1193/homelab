# Kandev - spec-driven kanban that runs CLI coding agents (Claude Code, Codex,
# Gemini CLI...) with their own logins. Copy to .env (git-crypt encrypted).

# Bind + port for the web UI and API. LAN only; remote access goes through a
# Cloudflare tunnel route protected by Cloudflare Access.
KANDEV_SERVER_HOST=0.0.0.0
KANDEV_SERVER_PORT=3040

# Built-in login (feature flag). Kandev has no auth by default: anyone who can
# reach the port can make agents run commands on this machine.
KANDEV_FEATURES_AUTH=true

# At most two agent sessions at a time across the whole instance (cache cost,
# subscription limits). Per-step WIP limits live in the workflows.
KANDEV_MAX_CONCURRENT_SESSIONS=2

# Where Kandev looks for git repos to attach to projects.
KANDEV_REPOSITORYDISCOVERY_ROOTS=/home/zfadli/my_repos

# Fork feature (FORK.md): let profiles use models the CLI accepts but the ACP
# catalog does not list yet, e.g. claude-opus-5-5.
KANDEV_FORK_UNLISTED_MODELS=true
