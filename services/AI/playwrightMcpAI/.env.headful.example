# playwright-mcp - HEADFUL instance (unit playwright-mcp-headful)
# ─────────────────────────────────────────────────────────────────────────────
# Runs a real visible browser alongside the default headless instance, which
# stays on 9012 for testing. Start with:
#     make start INSTANCE=headful
# ─────────────────────────────────────────────────────────────────────────────

PLAYWRIGHT_MCP_HOST=0.0.0.0
PLAYWRIGHT_MCP_PORT=9013

PLAYWRIGHT_MCP_ALLOWED_HOSTS=*
# Real Google Chrome, not Playwright's Chromium: sites trust it more and it
# reads the persistent profile below.
PLAYWRIGHT_MCP_BROWSER=chrome

# The whole point of this instance.
PLAYWRIGHT_MCP_HEADLESS=false

# false + PLAYWRIGHT_MCP_USER_DATA_DIR below = a persistent profile, so logins
# made by hand in this window survive restarts. It must NOT be
# ~/.config/google-chrome: Chrome >= 136 refuses automation on its default
# profile. Only one browser can hold the folder at a time.
PLAYWRIGHT_MCP_ISOLATED=false

# Anti-detection bundle generated by `make stealth`.
PLAYWRIGHT_MCP_STEALTH=true

# WM_CLASS marker i3 assigns on - see zfa_configs/i3/common/2_workspaces.sh.
PLAYWRIGHT_MCP_WM_CLASS=PlaywrightHeadful

PLAYWRIGHT_MCP_CHANNEL=
PLAYWRIGHT_MCP_LOCALE=
PLAYWRIGHT_MCP_VIEWPORT=
PLAYWRIGHT_MCP_USER_DATA_DIR=$HOME/.config/playwright-chrome-profile
