[Unit]
Description=Playwright MCP Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
{{USER_LINE}}
WorkingDirectory={{CURR_DIR}}
Environment="PATH={{PATH_VAL}}"
{{DISPLAY_ENV}}
ExecStart={{NPX_BIN}} -y @playwright/mcp@latest --host {{HOST}} --port {{PORT}} --browser {{BROWSER}} {{HEADLESS_FLAG}} {{ISOLATED_FLAG}} {{ALLOWED_HOSTS_FLAG}} {{USER_DATA_DIR_FLAG}} {{CONFIG_FLAG}} {{INIT_SCRIPT_FLAG}}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target multi-user.target
