# playwright-mcp configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust if needed - the defaults below work as-is.
# NEVER commit .env to version control - it is listed in the root .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Bind address for the HTTP/SSE server. Set to 0.0.0.0 to allow access from the LAN.
PLAYWRIGHT_MCP_HOST=0.0.0.0
PLAYWRIGHT_MCP_PORT=9012

# Allowed hosts for incoming HTTP requests (comma-separated, or * to disable host check for LAN/tunnel access)
PLAYWRIGHT_MCP_ALLOWED_HOSTS=*

# Browser to drive: chromium, chrome, firefox, webkit, msedge.
PLAYWRIGHT_MCP_BROWSER=chromium

# true = no visible window (required on this headless server).
PLAYWRIGHT_MCP_HEADLESS=true

# true = keep the browser profile in memory, never persist it to disk (no
# saved logins/cookies between restarts). Set to false for a persistent
# profile under ~/.cache/ms-playwright - useful if you want the driven
# browser to stay logged into sites across restarts.
PLAYWRIGHT_MCP_ISOLATED=true

# ─── Headful + anti-detection ────────────────────────────────────────────────
# Set false to run a real visible window. Requires DISPLAY/XAUTHORITY to reach
# an X session, which only a *user* systemd unit gets for free - see README.
# PLAYWRIGHT_MCP_HEADLESS is defined above; flip it there.

# Inject the generated anti-detection bundle (stealth/stealth-init.js) via
# --init-script and apply its launch args. Regenerate with `make stealth`.
PLAYWRIGHT_MCP_STEALTH=true

# WM_CLASS marker stamped on the window via --class, so i3 can assign it to a
# workspace without depending on the profile path. Must match the assign rule in
# zfa_configs/i3/common/2_workspaces.sh.
PLAYWRIGHT_MCP_WM_CLASS=PlaywrightHeadful

# Browser channel for launchOptions, e.g. "chrome" to drive the real installed
# Google Chrome instead of Playwright's bundled Chromium. Empty = bundled.
PLAYWRIGHT_MCP_CHANNEL=

# Context defaults. Empty = leave Playwright's own default alone.
PLAYWRIGHT_MCP_LOCALE=
PLAYWRIGHT_MCP_VIEWPORT=

# Profile directory used when PLAYWRIGHT_MCP_ISOLATED=false. A fixed path keeps
# logins across restarts; --isolated uses a fresh temp dir every time.
PLAYWRIGHT_MCP_USER_DATA_DIR=
