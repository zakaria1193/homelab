# playwright-mcp configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust if needed - the defaults below work as-is.
# NEVER commit .env to version control - it is listed in the root .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Bind address for the HTTP/SSE server. Keep this at 127.0.0.1 unless you
# trust everyone on your LAN with headless browser control - the MCP server
# has no auth of its own, and setting HOST=0.0.0.0 hands out that control to
# the whole network.
PLAYWRIGHT_MCP_HOST=127.0.0.1
PLAYWRIGHT_MCP_PORT=9012

# Browser to drive: chromium, chrome, firefox, webkit, msedge.
PLAYWRIGHT_MCP_BROWSER=chromium

# true = no visible window (required on this headless server).
PLAYWRIGHT_MCP_HEADLESS=true

# true = keep the browser profile in memory, never persist it to disk (no
# saved logins/cookies between restarts). Set to false for a persistent
# profile under ~/.cache/ms-playwright - useful if you want the driven
# browser to stay logged into sites across restarts.
PLAYWRIGHT_MCP_ISOLATED=true
