# Every *arr key below is a PLACEHOLDER. The real ones live in `.env` next to
# this file, which is committed as git-crypt ciphertext - never here: this repo
# is public, and an API key in a template is a key on the internet.
#
# Each service prints its own key under Settings -> General -> Security.

# ── Radarr (Movies) ──
RADARR_URL=http://localhost:7878/radarr
RADARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RADARR_ENABLED=true

# ── Sonarr (TV Series) ──
SONARR_URL=http://localhost:8989
SONARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONARR_ENABLED=true

# ── Lidarr (Music) ──
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=
LIDARR_ENABLED=false

# ── Prowlarr (Indexer Backbone) ──
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PROWLARR_ENABLED=true

# ── Readarr (Books) ──
READARR_URL=http://localhost:8787/readarr
READARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
READARR_ENABLED=true

# ── Overseerr (Media Requests & Discovery) ──
OVERSEERR_URL=http://localhost:5055
OVERSEERR_API_KEY=
OVERSEERR_ENABLED=false

# ── Bazarr (Subtitles) ──
BAZARR_URL=http://localhost:6767
BAZARR_API_KEY=
BAZARR_ENABLED=false

# ── Jellyfin Bridge (for cross-arr orchestration) ──
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# ── MCP Transport ──
ARR_MCP_TRANSPORT=sse
ARR_MCP_HOST=0.0.0.0
ARR_MCP_PORT=10938
ARR_MCP_PATH=/mcp

# ── Logging ──
ARR_LOG_LEVEL=INFO

# ── FastMCP Settings ──
FASTMCP_STATELESS_HTTP=1
FASTMCP_DEBUG=0
