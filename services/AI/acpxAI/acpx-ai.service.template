[Unit]
Description=ACPX AI Agent Client Protocol Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zfadli
WorkingDirectory=/home/zfadli/my_repos/homelab/services/AI/acpxAI
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/zfadli/.npm-global/bin:/home/zfadli/.local/bin"
Environment="ACPX_HOME=/home/zfadli/.acpx"
Environment="ACPX_AGENT=claude"
Environment="ACPX_TTL=0"
EnvironmentFile=-/home/zfadli/my_repos/homelab/services/AI/acpxAI/.env
ExecStart=/bin/sh -c '/home/zfadli/.npm-global/bin/acpx --ttl 0 --approve-reads claude sessions ensure --name daemon && while true; do sleep 60; /home/zfadli/.npm-global/bin/acpx --ttl 0 claude status >/dev/null 2>&1 || /home/zfadli/.npm-global/bin/acpx --ttl 0 --approve-reads claude sessions ensure --name daemon; done'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
