# pjm settings. Copy to .env (make env-setup). Real environment variables win over this file.

# Where the web page and API listen. 0.0.0.0 so the Cloudflare tunnel (on another host) can reach it.
PJM_HOST=0.0.0.0
PJM_PORT=8400

# The data folder: workflows, projects, tickets. A folder inside the notes repo.
PJM_DATA=~/Documents/notes_perso/pjm

# At most this many agent runs at the same time.
PJM_MAX_RUNS=2

# Do not start new Claude runs once session or weekly usage reaches this percent.
PJM_QUOTA_PAUSE=97

# Flag a run as too big after this many minutes, and shrink ticket files over this many KB.
PJM_RUN_MAX_MIN=45
PJM_TICKET_MAX_KB=64

# Watchdog: alert on a run with no output for this long, and on a wait on the owner this long.
PJM_SILENT_MIN=20
PJM_WAIT_ALERT_H=48

# The CLIs to run (change only for tests or a non-standard install).
PJM_CLAUDE_BIN=claude
PJM_AGY_BIN=agy

# Slack (a second Slack app, "pjm", with its own tokens; Kandev's plugin keeps the Homelab Bot).
# Bot token (xoxb-...) posts; app token (xapp-..., connections:write) receives thread replies.
# Leave both empty to run without Slack.
PJM_SLACK_BOT_TOKEN=
PJM_SLACK_APP_TOKEN=
# Comma-separated Slack user ids allowed to answer questions from a thread.
PJM_SLACK_ALLOWED_USERS=
# Channel for the Scrum master's health report.
PJM_SLACK_HEALTH_CHANNEL=
# Base URL used in links inside Slack posts (the tunnel URL once it exists).
PJM_BASE_URL=http://192.168.1.10:8400

# Scrum master (agy writes a health report a few times a day). Off until you turn it on.
PJM_SCRUM_ENABLED=1
# Local times in Europe/Paris, comma-separated.
PJM_SCRUM_TIMES=07:30,12:00,17:00,22:00
# Leave empty for agy's default model.
PJM_SCRUM_MODEL=
