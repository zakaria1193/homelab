[Unit]
Description=Hermes AI Agent Daemon & Dashboard
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
{{USER_LINE}}
WorkingDirectory={{CURR_DIR}}
Environment="PATH={{PATH_VAL}}"
Environment="HERMES_HOME={{HERMES_HOME}}"
Environment="DASHBOARD_PORT={{DASHBOARD_PORT}}"
Environment="HERMES_PORT={{HERMES_PORT}}"
Environment="PORT={{DASHBOARD_PORT}}"
Environment="API_SERVER_PORT={{DASHBOARD_PORT}}"
EnvironmentFile=-{{CURR_DIR}}/.env
ExecStart={{HERMES_BIN}} {{HERMES_CMD}}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target multi-user.target
