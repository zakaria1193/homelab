# aicli-ai configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust if needed - the defaults below work as-is.
# The real .env is committed via git-crypt (see /.gitattributes); it holds
# AICLI_API_KEY when the service listens beyond loopback.
# ─────────────────────────────────────────────────────────────────────────────

# Bind address. Defaults to loopback. To allow container or LAN access
# (e.g. Karakeep), set all three - server.py refuses a non-loopback bind
# without a key, and non-loopback callers must send `Authorization: Bearer <key>`:
# AICLI_HOST=0.0.0.0
# AICLI_ALLOW_NON_LOOPBACK=1
# AICLI_API_KEY=<openssl rand -base64 32>
AICLI_HOST=127.0.0.1
AICLI_PORT=8500

# Max CLI subprocesses running at once. More requests wait their turn.
AICLI_MAX_CONCURRENT=2

# Seconds before a CLI run is killed and the request gets a 504.
AICLI_TIMEOUT=600

# Where each request's token use is logged, one JSON line per model.
# pjm's Usage page reads this file (PJM_AICLI_USAGE). Empty means the default.
AICLI_USAGE_LOG=~/.local/state/aicli/usage.jsonl

# Label for a non-loopback caller's usage log lines when it sends neither an
# X-Aicli-Client header nor an OpenAI `user` field. Only used when
# AICLI_ALLOW_NON_LOOPBACK is set; unset means those lines show "unknown".
# AICLI_REMOTE_CLIENT=karakeep:tagger
