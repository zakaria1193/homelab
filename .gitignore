.env
.mcp.json
.agents/
upgrade.log
.last_upgrade

# Runtime logs & debug artifacts
*.log
*.log.*
**/logs/
**/.playwright-mcp/
**/.browser/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Stray empty database from a run in the wrong directory
services/AI/jobs.db

# Python bytecode
__pycache__/

# Keep versioned global agent rules tracked even if ~/.gitignore_global ignores AGENTS.md / CLAUDE.md
!services/AI/rules/*.md
