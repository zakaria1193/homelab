# Homelab Notification & Shared Secrets Template
# Copy to .env in repo root or ~/.config/homelab/slack.env

# Method 1: Slack Incoming Webhook (Recommended & Simplest)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/<WORKSPACE_ID>/<CHANNEL_ID>/<TOKEN>"

# Method 2: Slack Bot Token (Alternative)
# SLACK_BOT_TOKEN="xoxb-your-bot-token"
# SLACK_CHANNEL_ID="C01234567"
